    "tool_decision":       { "p95": 7.0, "ceiling": 9.0, "unit": "s", "samples": 3, "warmup": 1 }
  },
  "gate": { "enforce": ["wake_to_first_token", "simple_reply"], "report_only": ["tool_decision"] }
}
